{
  "name": "tracepermit",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic runtime visibility and control proof of concept",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @tracepermit/console build",
    "test": "pnpm --filter @tracepermit/console test",
    "typecheck": "pnpm --filter @tracepermit/console typecheck",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm java:env-check && pnpm java:check",
    "dev:backend": "scripts/run-java-development-backend.sh",
    "dev:java-api": "scripts/run-java-development-backend.sh",
    "dev:java-endpoint": "scripts/run-java-endpoint-connector.sh",
    "dev:console": "pnpm --filter @tracepermit/console dev",
    "dev:approvals": "scripts/run-java-simulator-approvals.sh",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "demo": "scripts/run-demo.sh",
    "demo:run": "scripts/run-demo-scenarios.sh",
    "demo:scenario:connector": "scripts/run-connector-origin-scenario.sh",
    "demo:scenario:connector:auto": "scripts/run-connector-origin-scenario.sh --auto",
    "demo:scenario:cli": "scripts/run-live-cli-scenario.sh",
    "demo:scenario:cli:auto": "scripts/run-live-cli-scenario.sh --auto",
    "demo:scenario:approval": "scripts/run-request-bound-approval-scenario.sh",
    "demo:scenario:approval:auto": "scripts/run-request-bound-approval-scenario.sh --auto",
    "demo:scenario:production-deletion": "scripts/run-production-deletion-approval-scenario.sh",
    "demo:scenario:production-deletion:auto": "scripts/run-production-deletion-approval-scenario.sh --auto",
    "demo:scenario:semantic": "scripts/run-signed-scheduled-semantic-scenario.sh",
    "demo:scenario:semantic:auto": "scripts/run-signed-scheduled-semantic-scenario.sh --auto",
    "demo:scenario:scheduled-stop": "scripts/run-signed-scheduled-stop-scenario.sh",
    "demo:scenario:scheduled-stop:auto": "scripts/run-signed-scheduled-stop-scenario.sh --auto",
    "demo:scenario:pii-exfil": "scripts/run-synthetic-pii-exfil-scenario.sh",
    "demo:scenario:pii-exfil:auto": "scripts/run-synthetic-pii-exfil-scenario.sh --auto",
    "demo:scenario:prompt-injection": "scripts/run-tool-result-prompt-injection-scenario.sh",
    "demo:scenario:prompt-injection:auto": "scripts/run-tool-result-prompt-injection-scenario.sh --auto",
    "demo:scenario:delegation": "scripts/run-sub-agent-delegation-scenario.sh",
    "demo:scenario:delegation:auto": "scripts/run-sub-agent-delegation-scenario.sh --auto",
    "demo:scenario:qualification": "scripts/run-semantic-qualification.sh",
    "demo:tunnel": "scripts/run-openai-tunnel-demo.sh",
    "demo:oauth": "scripts/run-hosted-client-oauth-demo.sh",
    "demo:tunnel:oauth": "scripts/run-openai-oauth-tunnel-demo.sh",
    "demo:verify": "scripts/verify-demo-qualification.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:links": "node --test scripts/doc-link-target.test.mjs && node scripts/check-doc-links.mjs",
    "portability:check": "scripts/run-java-portability-check.sh",
    "java:check": "scripts/run-java-check.sh",
    "test:java-postgres": "scripts/run-java-postgres-tests.sh",
    "test:approval-api": "scripts/run-java-approval-api-tests.sh",
    "java:env-check": "scripts/test-java-environment.sh",
    "build:java-endpoint": "scripts/build-java-endpoint-connector.sh",
    "test:endpoint-connector-e2e": "scripts/test-java-endpoint-connector-e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
