# Copy to a private operator-controlled file and replace every value.
# Prefer an immutable registry digest for an externally supplied image.
TRACEPERMIT_CONTAINER_IMAGE=tracepermit/simulator-approval:replace-with-version-and-commit
TRACEPERMIT_PRIVATE_DIR=/absolute/path/to/tracepermit-private-input
TRACEPERMIT_APPROVAL_PORT=18085
TRACEPERMIT_POSTGRES_PORT=55432
TRACEPERMIT_POSTGRES_DATABASE=tracepermit_approvals
TRACEPERMIT_POSTGRES_USER=tracepermit_approvals
