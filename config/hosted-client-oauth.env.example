# Public/provider identifiers only. Do not place tokens, secrets, or private keys here.
export TRACEPERMIT_OAUTH_ISSUER='https://YOUR_IDP_ISSUER'
export TRACEPERMIT_OAUTH_AUTHORIZATION_SERVER='https://YOUR_IDP_ISSUER'
export TRACEPERMIT_OAUTH_JWKS_URI='https://YOUR_IDP_ISSUER/PATH_TO_JWKS'

# Use the exact protected-resource and metadata identifiers shown/configured for the tunnel.
export TRACEPERMIT_OAUTH_RESOURCE='https://YOUR_TRACEPERMIT_RESOURCE'
export TRACEPERMIT_OAUTH_RESOURCE_METADATA_URI='https://YOUR_TRACEPERMIT_RESOURCE/.well-known/oauth-protected-resource'

# Exact client_id claim emitted in the provider's RFC 9068 access token. With
# CIMD, this may be the provider's internal registration ID rather than the
# public client-metadata URL used to begin registration.
export TRACEPERMIT_OAUTH_CLIENT_ID='REPLACE_WITH_PROVIDER_TOKEN_CLIENT_ID'
export TRACEPERMIT_OAUTH_CLIENT_NAME='ChatGPT hosted client'

# Configure the IdP to issue this bounded claim and map it to a non-secret demo tenant.
export TRACEPERMIT_OAUTH_TENANT_CLAIM='https://tracepermit.example/tenant'
export TRACEPERMIT_OAUTH_TENANT_VALUE='REPLACE_WITH_IDP_TENANT_VALUE'
export TRACEPERMIT_OAUTH_TENANT_ID='tenant:demo'

# offline_access supports hosted-client refresh continuity only. It is not a
# TracePermit tool authority; the independent tool scopes remain mandatory.
export TRACEPERMIT_OAUTH_SCOPES='openid profile email offline_access aws.logs.discover aws.logs.read'
export TRACEPERMIT_OAUTH_ORIGIN='chatgpt-web'

# Space-separated, explicit HTTPS origins that tunnel-client may fetch during
# OAuth discovery. Include the configured public authorization-server origin;
# do not use wildcards, paths, credentials, or unrelated destinations.
export TRACEPERMIT_OAUTH_TRUSTED_ORIGINS='https://YOUR_IDP_ISSUER_ORIGIN'
