{
  "$id": "https://schemas.tracepermit.invalid/v1/policy-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "defaultDecision": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "allow",
            "block",
            "sanitize",
            "require_approval"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "outcome",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "object",
            "properties": {
              "origins": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chatgpt-web",
                    "claude-web",
                    "cli",
                    "api",
                    "scheduler"
                  ]
                }
              },
              "subjectTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "human",
                    "workload"
                  ]
                }
              },
              "targetSystems": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "environments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "dev",
                    "test",
                    "staging",
                    "prod"
                  ]
                }
              },
              "actionClasses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "read",
                    "modify",
                    "destructive",
                    "orchestration"
                  ]
                }
              },
              "toolNames": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requiredSignals": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minimumSeverity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            },
            "additionalProperties": false
          },
          "decision": {
            "type": "object",
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "allow",
                  "block",
                  "sanitize",
                  "require_approval"
                ]
              },
              "reasonCode": {
                "type": "string",
                "minLength": 1
              },
              "approvalGroup": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "outcome",
              "reasonCode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "priority",
          "description",
          "match",
          "decision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "enabled",
    "defaultDecision",
    "rules"
  ],
  "additionalProperties": false
}
