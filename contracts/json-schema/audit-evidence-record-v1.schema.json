{
  "$id": "https://schemas.tracepermit.invalid/v1/audit-evidence-record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "evidenceEventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "streamId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "action_observed",
            "evaluation_completed",
            "execution_authority_issued",
            "execution_denied",
            "execution_not_started",
            "execution_dispatched",
            "execution_succeeded",
            "execution_failed",
            "execution_outcome_unknown",
            "reconciliation_completed"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "producer": {
          "type": "object",
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "component",
            "version"
          ],
          "additionalProperties": false
        },
        "correlation": {
          "type": "object",
          "properties": {
            "traceId": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "eventId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "evaluationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "permitId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "idempotencyKey": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "traceId",
            "eventId"
          ],
          "additionalProperties": false
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "actionHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "decision": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "allow",
                "block",
                "sanitize",
                "require_approval"
              ]
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "outcome",
            "reasonCode"
          ],
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "denied",
                "not_executed",
                "authorized",
                "executing",
                "succeeded",
                "failed",
                "unknown"
              ]
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "credentialFingerprints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "evidenceEventId",
        "streamId",
        "sequence",
        "kind",
        "occurredAt",
        "recordedAt",
        "producer",
        "correlation",
        "subjectId",
        "actionHash",
        "credentialFingerprints"
      ],
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "previousEventHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "previousEventHash",
        "eventHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "payload",
    "integrity"
  ],
  "additionalProperties": false
}
