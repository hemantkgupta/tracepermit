{
  "$id": "https://schemas.tracepermit.invalid/v1/evaluation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evaluationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "classification": {
      "type": "object",
      "properties": {
        "actionClass": {
          "type": "string",
          "enum": [
            "read",
            "modify",
            "destructive",
            "orchestration"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "classifier": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "deterministic",
                "cached",
                "semantic_model"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "actionClass",
        "severity",
        "score",
        "operation",
        "signals",
        "classifier"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "allow",
            "block",
            "sanitize",
            "require_approval"
          ]
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "matchedRuleId": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "approvalGroup": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "outcome",
        "policyId",
        "policyVersion",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "evaluationId",
    "evaluatedAt",
    "eventId",
    "classification",
    "decision",
    "latencyMs"
  ],
  "additionalProperties": false
}
