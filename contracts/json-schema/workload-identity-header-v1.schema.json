{
  "$id": "https://schemas.tracepermit.invalid/v1/workload-identity-header-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "alg": {
      "type": "string",
      "const": "EdDSA"
    },
    "typ": {
      "type": "string",
      "const": "tracepermit-workload-identity+jws"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"
    }
  },
  "required": [
    "alg",
    "typ",
    "kid"
  ],
  "additionalProperties": false
}
